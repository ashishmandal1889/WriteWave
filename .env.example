# ==============================================================================
# WriteWave - Environment Variables Configuration Reference for Render
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Environment Variables (Render Web Service)
# ------------------------------------------------------------------------------
# Service Name on Render: writewave-backend
# Root Directory: backend
# Build Command: npm install
# Start Command: npm start

NODE_ENV=production
PORT=10000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/writewave?retryWrites=true&w=majority
JWT_SECRET=your_secure_random_jwt_secret_string_here
CLIENT_URL=https://your-frontend-service.onrender.com
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# Frontend Static Site Environment Variables (Render Static Site)
# ------------------------------------------------------------------------------
# Service Name on Render: writewave-frontend
# Root Directory: frontend
# Build Command: npm install && npm run build
# Publish Directory: dist

VITE_API_URL=https://your-backend-service.onrender.com/api/v1
