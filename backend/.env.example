# WriteWave Backend Environment Configuration Example
# In production on Render, configure these in the Render Dashboard Environment settings.

# Server Configuration (Render assigns PORT automatically via process.env.PORT, default 10000 on Render)
PORT=5000
NODE_ENV=development

# Allowed Frontend Client URL for CORS (e.g. https://your-frontend-service.onrender.com)
CLIENT_URL=http://localhost:3000

# API Versioning Prefix
API_PREFIX=/api/v1

# MongoDB Connection String (MongoDB Atlas in production, local for development)
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/writewave?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/writewave

# JWT Authentication Secret and Expiration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
